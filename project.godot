; Engine configuration file.
; Rugby 27 — Godot 4.4+

config_version=5

[application]

config/name="Rugby 27"
config/description="A modern spiritual successor to classic console rugby."
run/main_scene="res://game/match/match.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[autoload]

InputSetup="*res://game/core/input_setup.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=60
common/physics_interpolation=true
3d/physics_engine="Jolt Physics"

[rendering]

anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
